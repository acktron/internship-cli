# Copy to .env in the project root (internship-radar loads it via python-dotenv).
# Shell exports still win over values here.

LLM_BACKEND=ollama
OLLAMA_MODEL=qwen2.5:3b

# Only needed when LLM_BACKEND=gemini
# GEMINI_API_KEY=

# Company-posts / agent: keyword variations per company (default 10, max 15)
MAX_QUERIES_PER_COMPANY=7
